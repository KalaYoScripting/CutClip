<Window x:Class="CutClip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="CutClip"
        Width="0"
        Height="0"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Visibility="Hidden">
    <tb:TaskbarIcon x:Name="TrayIcon"
                    ToolTipText="CutClip — Screen Region Recorder"
                    IconSource="/Assets/app-icon.ico"
                    TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick"
                    TrayBalloonTipClicked="TrayIcon_TrayBalloonTipClicked">
        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Select Region &amp; Record" Click="SelectRegion_Click"/>
                <MenuItem x:Name="StopMenuItem" Header="Stop Recording" Click="StopRecording_Click" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Settings..." Click="Settings_Click"/>
                <MenuItem Header="Recent Recordings..." Click="RecentRecordings_Click"/>
                <MenuItem Header="Open Videos Folder" Click="OpenVideosFolder_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>
</Window>
